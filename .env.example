# Copy to .env (which is gitignored) and fill in. Never commit real values.

# EIA Open Data API v2 key — https://www.eia.gov/opendata/register.php
EIA_API_KEY=

# PJM Data Miner 2 subscription key — https://apiportal.pjm.com
PJM_API_KEY=

# Contact address sent in the User-Agent for NWS (api.weather.gov) and USGS requests
GENSIM_CONTACT_EMAIL=
